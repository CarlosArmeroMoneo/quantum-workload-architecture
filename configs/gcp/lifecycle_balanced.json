{
  "rule": [
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 30,
        "matchesPrefix": [
          "profiler-artifacts/scratch/"
        ]
      }
    },
    {
      "action": {
        "type": "SetStorageClass",
        "storageClass": "NEARLINE"
      },
      "condition": {
        "age": 30,
        "matchesPrefix": [
          "batch-logs/",
          "tpu-runs/"
        ]
      }
    },
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 180,
        "matchesPrefix": [
          "batch-logs/",
          "tpu-runs/"
        ]
      }
    },
    {
      "action": {
        "type": "SetStorageClass",
        "storageClass": "NEARLINE"
      },
      "condition": {
        "age": 30,
        "matchesPrefix": [
          "profiler-artifacts/canonical/"
        ]
      }
    },
    {
      "action": {
        "type": "SetStorageClass",
        "storageClass": "COLDLINE"
      },
      "condition": {
        "age": 180,
        "matchesPrefix": [
          "profiler-artifacts/canonical/"
        ]
      }
    },
    {
      "action": {
        "type": "SetStorageClass",
        "storageClass": "ARCHIVE"
      },
      "condition": {
        "age": 365,
        "matchesPrefix": [
          "profiler-artifacts/canonical/"
        ]
      }
    }
  ]
}
