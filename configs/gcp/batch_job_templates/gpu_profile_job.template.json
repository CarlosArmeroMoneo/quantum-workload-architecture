{
  "name": "{{JOB_NAME}}",
  "labels": {
    "app": "qwa",
    "lane": "gpu-profile",
    "claim": "pending",
    "dry_run": "true",
    "profiler": "{{PROFILER_KIND}}"
  },
  "taskGroups": [
    {
      "taskCount": 1,
      "parallelism": 1,
      "taskSpec": {
        "runnables": [
          {
            "container": {
              "imageUri": "{{CONTAINER_IMAGE}}",
              "commands": [
                "bash",
                "-lc",
                "{{STARTUP_COMMAND}}"
              ]
            }
          }
        ],
        "environment": {
          "variables": {
            "QWA_DRY_RUN": "true",
            "QWA_DRY_RUN_SOURCE": "scripts/render_gcp_batch_job.py",
            "QWA_JOB_NAME": "{{JOB_NAME}}",
            "QWA_WORKLOAD_MANIFEST": "{{WORKLOAD_MANIFEST}}",
            "QWA_SYSTEM_MANIFEST": "{{SYSTEM_MANIFEST}}",
            "QWA_PROFILER_KIND": "{{PROFILER_KIND}}",
            "QWA_OUTPUT_GCS_PREFIX": "{{OUTPUT_GCS_PREFIX}}",
            "QWA_PROFILE_OUTDIR": "{{PROFILE_OUTDIR}}"
          }
        },
        "computeResource": {
          "cpuMilli": "{{CPU_MILLI}}",
          "memoryMib": "{{MEMORY_MIB}}"
        },
        "maxRunDuration": "{{MAX_RUN_DURATION}}"
      }
    }
  ],
  "allocationPolicy": {
    "instances": [
      {
        "policy": {
          "machineType": "{{MACHINE_TYPE}}",
          "accelerators": [
            {
              "type": "{{ACCELERATOR_TYPE}}",
              "count": "{{ACCELERATOR_COUNT}}"
            }
          ],
          "bootDisk": {
            "sizeGb": "{{BOOT_DISK_GB}}"
          }
        }
      }
    ]
  },
  "logsPolicy": {
    "destination": "CLOUD_LOGGING"
  }
}
